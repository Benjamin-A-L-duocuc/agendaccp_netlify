---
interface PhoneEntry {
  number: string;
  timeLabel?: string;
  blockLabel?: string;
}

interface Props {
  post: {
    data: {
      title: string;
      description?: string;
      phone?: string;
      phones?: PhoneEntry[];
      moreInfo?: string;
      location?: string;
      scheduleWeekdays?: string;
      scheduleSaturday?: string;
      scheduleSunday?: string;
      email?: string;
      whatsapp?: string;
      links?: string;
    }
  }
}

const { post } = Astro.props;
const { data } = post;

const parsedLinks: { text: string; url: string }[] = (data.links || '')
  .split('\n')
  .map(line => line.trim())
  .filter(line => line.includes('|'))
  .map(line => {
    const [text, ...urlParts] = line.split('|').map(s => s.trim());
    return { text, url: urlParts.join('|').trim() };
  })
  .filter(l => l.text && l.url);

function norm(s: string | undefined | null): string {
  return (s || '').toLowerCase().replace(/\s+/g, '-');
}

const phoneEntries: PhoneEntry[] = data.phones?.length
  ? data.phones.map(p => ({ ...p, timeLabel: norm(p.timeLabel), blockLabel: norm(p.blockLabel) }))
  : data.phone
    ? [{ number: data.phone, timeLabel: 'general', blockLabel: 'general' }]
    : [];

const useSlider = phoneEntries.length === 1
  && phoneEntries[0].timeLabel === 'general'
  && phoneEntries[0].blockLabel === 'general';

function formatLabel(entry: PhoneEntry): string | null {
  const t = entry.timeLabel && entry.timeLabel !== 'general' ? entry.timeLabel : null;
  const b = entry.blockLabel && entry.blockLabel !== 'general' ? entry.blockLabel : null;
  if (!t && !b) return null;
  const timePart = t ? t.charAt(0).toUpperCase() + t.slice(1) : null;
  const blockPart = b === 'bloque-h' ? 'Bloque H' : b === 'bloque-b' ? 'Bloque B' : null;
  if (t && b) return `${timePart} – ${blockPart}`;
  return timePart || blockPart;
}

function colorClass(entry: PhoneEntry): string {
  const t = entry.timeLabel && entry.timeLabel !== 'general' ? entry.timeLabel : null;
  const b = entry.blockLabel && entry.blockLabel !== 'general' ? entry.blockLabel : null;
  if (t && b) {
    if (b === 'bloque-b') return `phone-btn-combined-${t}`;
    return `phone-btn-${t}`;
  }
  if (t) return `phone-btn-${t}`;
  if (b) return `phone-btn-${b}`;
  return 'phone-btn-general';
}

function phoneNumber(entry: PhoneEntry): string {
  const n = entry.number || '';
  const raw = n.replace(/\s+/g, '');
  return raw;
}
---

<div class="col-12 col-md-6 d-flex">
  <article class="card card-custom p-3 d-flex flex-column w-100">
    <div class="place text-center">
      <h3>{data.title}</h3>
    </div>
    <div class="flex-grow-1 d-flex flex-column justify-content-evenly" style="row-gap:2px">
      <div class="contact-description">
        {data.description || ''}
      </div>
      {data.location && (
        <div class="contact-location">📍 {data.location}</div>
      )}
      {useSlider && (
        <div class="phone-number">
          {data.phone || data.phones?.[0]?.number || 'No disponible'}
        </div>
      )}
      <div class="schedule-status"
           data-open-weekdays={data.scheduleWeekdays}
           data-open-saturday={data.scheduleSaturday}
           data-open-sunday={data.scheduleSunday}>
        <span class="status-dot"></span>
        <span class="status-text">Cargando...</span>
      </div>
      <div class="schedule-chips">
        {data.scheduleWeekdays && (
          <div class="chip">
            <span class="chip-label">Lun–Vie</span>
            <span class="chip-time">{data.scheduleWeekdays}</span>
          </div>
        )}
        {data.scheduleSaturday && (
          <div class="chip">
            <span class="chip-label">Sáb</span>
            <span class="chip-time">{data.scheduleSaturday}</span>
          </div>
        )}
        {data.scheduleSunday && (
          <div class="chip">
            <span class="chip-label">Dom</span>
            <span class="chip-time">{data.scheduleSunday}</span>
          </div>
        )}
      </div>
      {data.moreInfo && (
        <details class="more-info">
          <summary class="more-info-summary">
            <span class="more-info-chevron">▸</span>
            Más información
          </summary>
          <div class="more-info-content">{data.moreInfo}</div>
        </details>
      )}
      {parsedLinks.length > 0 && (
        <div class="links-grid">
          {parsedLinks.map(link => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-btn">
              {link.text}
            </a>
          ))}
        </div>
      )}
    </div>
    <div>
      {useSlider
        ? (
          <div class="slider-call" data-phone={phoneNumber(phoneEntries[0])}>
            <div class="slider-text">Desliza para llamar →</div>
            <div class="slider-btn">☎</div>
          </div>
        )
        : phoneEntries.length > 0 && (
          <div class={`phone-grid phone-grid-${Math.min(phoneEntries.length, 4)}`}>
            {phoneEntries.map((entry, i) => {
              const label = formatLabel(entry);
              const num = phoneNumber(entry);
              const isFull = phoneEntries.length === 3 && i === phoneEntries.length - 1;
              return (
                <a href={`tel:${num}`} class={`phone-btn ${colorClass(entry)} ${isFull ? 'phone-btn-full' : ''}`}>
                  <span class="phone-btn-label">{label || 'Llamar'}</span>
                  <span class="phone-btn-num">{entry.number}</span>
                </a>
              );
            })}
          </div>
        )
      }
      {data.whatsapp && (
        <div class="slider-call mt-2" data-whatsapp={data.whatsapp.replace(/\s+/g, '')}>
          <div class="slider-text">Desliza para WhatsApp →</div>
          <div class="slider-btn">☎</div>
        </div>
      )}
      {data.email && (
        <div class="slider-call mt-2" data-email={data.email}>
          <div class="slider-text">Desliza para correo →</div>
          <div class="slider-btn">✉</div>
        </div>
      )}
    </div>
  </article>
</div>
